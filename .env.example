# .env — Environment variables for the Autonomous Web Testing Framework
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------
# LLM Configuration (Required)
# ---------------------------------------------------------------

# Your OpenRouter API key (required)
OPENAI_API_KEY=sk-or-v1-your-key-here

# OpenRouter base URL
OPENAI_API_BASE=https://openrouter.ai/api/v1

# LLM model to use
# LLM_MODEL=openai/gpt-4.1-mini

# Temperature for LLM responses (0.0 = deterministic, default)
# LLM_TEMPERATURE=0.0

# Limit completion budgets to keep OpenRouter costs low
LLM_MAX_TOKENS=1024
PLANNER_MAX_TOKENS=1024
EXECUTOR_MAX_TOKENS=128
HEALER_MAX_TOKENS=128
CONSOLE_ANALYSIS_MAX_TOKENS=256

# ---------------------------------------------------------------
# Browser Configuration
# ---------------------------------------------------------------

# Run browser in headless mode (true = invisible, false = visible window)
HEADLESS=false

# Timeout for browser actions in milliseconds
# BROWSER_TIMEOUT=10000

# Default wait time for locator operations in milliseconds
# DEFAULT_WAIT_TIME=5000

# ---------------------------------------------------------------
# Output Paths
# ---------------------------------------------------------------

# Path to save the Playwright trace file
# TRACE_PATH=trace.zip

# Path to save the HTML test report
# REPORT_PATH=report.html

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
